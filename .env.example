# Copy this file to .env and fill in your real keys. Never commit .env.
#
# Which LLM provider the tutor talks to: "gemini" (recommended) or "openrouter".
LLM_PROVIDER=gemini

# --- Google Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Thinking models reason before answering, which is slow. 0 disables that (fastest);
# set to -1 only if a future model rejects thinkingBudget. Free tier is ~20 req/min.
GEMINI_THINKING_BUDGET=0
# Neural text-to-speech model + voice (server-side spoken narration).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Kore

# --- Narration voice selection ---
# Lessons are spoken by the first narrator that answers, in this order:
#   1. Kokoro-82M, running locally (no API key, no quota, works offline)
#   2. Edge TTS (Microsoft neural voices, free, no key)
#   3. Gemini TTS (needs GEMINI_TTS_MODEL above; tight free quota)
# Kokoro is used automatically whenever these two files exist (338 MB, gitignored,
# Apache-2.0, no key and no quota — they never leave your machine):
#   curl -L -o models/kokoro-v1.0.onnx  https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx
#   curl -L -o models/voices-v1.0.bin   https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin
# plus: pip install kokoro-onnx soundfile
# TTS_PROVIDER only reorders the two hosted fallbacks used when it isn't available.
TTS_PROVIDER=edge
# Kokoro voice name — list them with:
#   python -c "from kokoro_onnx import Kokoro; print(Kokoro('models/kokoro-v1.0.onnx','models/voices-v1.0.bin').get_voices())"
# af_* = American female, bf_* = British female, am_* = American male, bm_* = British male.
KOKORO_VOICE=af_heart
# How long a spoken line may hold up /api/tts before the browser's own voice covers it
# (the local narrator runs at ~1.6-2.4x real time, so upcoming lines are generated ahead).
KOKORO_WAIT_SECONDS=3
# Background narrator threads. More = warmer cache sooner, but they share the CPU with
# everything else on this machine. Four is about the point where extra threads stop
# helping an 8-core box.
KOKORO_WORKERS=4
# Any Microsoft Edge neural voice. The conversational-class voices sound the most
# natural: en-US-AvaNeural (default), en-US-AndrewNeural, en-US-EmmaNeural,
# en-US-BrianNeural; also en-KE-AsiliaNeural (Kenyan English), en-GB-SoniaNeural.
# Full list:
#   python -m edge_tts --list-voices
EDGE_TTS_VOICE=en-US-AvaNeural

# --- OpenRouter (fallback; text only, no TTS) ---
# Key from https://openrouter.ai/keys . Free tier is capped at 50 requests/day.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
